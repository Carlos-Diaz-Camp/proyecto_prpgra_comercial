// Crear estas medidas en una tabla de Power BI llamada Uso.
// El prefijo "Total" evita colisiones con las columnas del mismo nombre.
Total consultas = SUM(Uso[consultas])
Total tokens = SUM(Uso[tokens_total])
Tokens entrada total = SUM(Uso[tokens_entrada])
Tokens salida total = SUM(Uso[tokens_salida])
Total completadas = SUM(Uso[completadas])
Total bloqueadas = SUM(Uso[bloqueadas])
